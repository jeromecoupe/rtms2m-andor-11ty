{
  "name": "rtms2m-andor-11ty",
  "version": "1.0.0",
  "description": "One page Andor fan site",
  "keywords": [
    "11ty",
    "eleventy",
    "static",
    "Andor"
  ],
  "homepage": "https://github.com/jeromecoupe/rtms2m-andor-11ty#readme",
  "bugs": {
    "url": "https://github.com/jeromecoupe/rtms2m-andor-11ty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeromecoupe/rtms2m-andor-11ty.git"
  },
  "license": "MIT",
  "author": "Jérôme Coupé, Nox Nguyên",
  "type": "module",
  "browserslist": ">= 0.5% and not dead",
  "main": "index.js",
  "scripts": {
    "eleventy": "npx @11ty/eleventy --quiet",
    "serve": "npx @11ty/eleventy --serve",
    "css:dev": "lightningcss --bundle \"./src/assets/css/styles.css\" -o \"./dist/assets/css/styles.css\"",
    "css:prod": "npm run css:dev -- --minify",
    "js:dev": "esbuild \"./src/assets/js/main.js\" --bundle --outfile=\"./dist/assets/js/main.js\"",
    "js:prod": "npm run js:dev -- --minify",
    "watch:css": "onchange \"./src/assets/css/**/*.css\" -- npm run css:dev",
    "watch:js": "onchange \"./src/assets/js/**/*.js\" -- npm run js:dev",
    "build": "concurrently \"npm run eleventy\" \"npm run css:prod\" \"npm run js:prod\"",
    "dev": "concurrently \"npm run serve\" \"npm run watch:css\" \"npm run watch:js\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "lightningcss-cli": "^1.33.0",
    "onchange": "^7.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "lightningcss-cli@1.33.0": true
  }
}
